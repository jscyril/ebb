<?xml version="1.0" encoding="utf-8"?>
<!-- Splash icon: the tide rises inside the ring (700 ms, under the 1000 ms platform cap). The static drawable rests
     with the wave up, so the pre-API-31 static splash shows the full mark; the animator starts it from 24. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/splash_icon_static">
    <target android:name="wave" android:animation="@animator/splash_wave_rise" />
</animated-vector>
